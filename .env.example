# Banco de dados (Postgres local)
# DB_USER/DB_PASSWORD: role ADMIN, usado só para rodar as migrations do Flyway
# (precisa poder criar tabelas/roles/policies). NUNCA é usado pelas queries da
# aplicação — se fosse, o RLS de V10__rls_policies.sql seria ignorado (um role
# superuser bypassa RLS incondicionalmente, é assim que o bug ficou escondido antes).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cotacao_dev
DB_USER=cotacao
DB_PASSWORD=cotacao

# APP_DB_USER/APP_DB_PASSWORD: role de RUNTIME (cotacao_app, criado por V10, sem
# BYPASSRLS). É essa credencial que a aplicação usa para toda query de negócio — é
# o que faz o RLS realmente valer. A senha é setada na role pela migration V14
# (via spring.flyway.placeholders.app_db_password = este valor).
APP_DB_USER=cotacao_app
APP_DB_PASSWORD=cotacao_app_dev

# JWT — troque em produção por uma string aleatória com >= 32 caracteres
JWT_SECRET=dev-secret-change-in-prod-needs-32-chars-minimum

# CORS — comma-separated, sem default em prod (SecurityConfig falha o boot se não
# setar). Em dev/test já vem fixo em http://localhost:3000 via application-dev.yml.
# APP_CORS_ALLOWED_ORIGINS=https://app.prx.com.br

# WhatsApp (Fase 2) — placeholders de dev, não batem na Graph API real
# (WHATSAPP_ENVIO_HABILITADO=false evita chamada de verdade sem credenciais válidas).
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret-change-in-prod
WHATSAPP_ACCESS_TOKEN=dev-access-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ENVIO_HABILITADO=false

# Usado só pelo build do serviço `frontend` no docker-compose.yml (build-arg —
# NEXT_PUBLIC_* precisa estar disponível em build-time do Next.js, não só runtime).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Para produção, todos os valores abaixo são obrigatórios (sem defaults)
# DB_HOST=<host do banco gerenciado>
# DB_PORT=5432
# DB_NAME=cotacao
# DB_USER=<usuário admin, só migrations>
# DB_PASSWORD=<senha forte>
# APP_DB_USER=cotacao_app
# APP_DB_PASSWORD=<senha forte, diferente da do DB_PASSWORD>
# JWT_SECRET=<string aleatória de >= 64 chars>
# APP_CORS_ALLOWED_ORIGINS=<origem(ns) real(is) do frontend em prod>
# WHATSAPP_VERIFY_TOKEN=<token real configurado no app da Meta>
# WHATSAPP_APP_SECRET=<app secret real da Meta>
# WHATSAPP_ACCESS_TOKEN=<access token real da Meta>
# WHATSAPP_PHONE_NUMBER_ID=<phone number id real da Meta>
# NEXT_PUBLIC_API_URL=<URL pública real da API em prod>
