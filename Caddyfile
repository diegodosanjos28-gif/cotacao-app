{$CADDY_DOMAIN} {
    # Navegação interna do Next.js (RSC) tem prioridade — sempre vai pro frontend,
    # mesmo que o path pareça bater com uma rota de API.
    @rsc {
        header RSC *
    }
    reverse_proxy @rsc frontend:3000

    @rscQuery {
        query _rsc=*
    }
    reverse_proxy @rscQuery frontend:3000

    @api path /auth /auth/* /cotacoes /cotacoes/* /produtos /produtos/* /fornecedores /fornecedores/* /admin /admin/* /usuarios /usuarios/* /whatsapp /whatsapp/* /dev /dev/* /actuator /actuator/*
    reverse_proxy @api backend:8080

    reverse_proxy frontend:3000
}
